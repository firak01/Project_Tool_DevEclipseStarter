<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.eclipse.jdt.launching.localJavaApplication">
    <booleanAttribute key="org.eclipse.debug.core.ATTR_FORCE_SYSTEM_CONSOLE_ENCODING" value="false"/>
    <listAttribute key="org.eclipse.debug.core.MAPPED_RESOURCE_PATHS">
        <listEntry value="/Tool_DevEclipseStarter/src/use/tool/eclipse/starter/DevEclipseStarterMain.java"/>
    </listAttribute>
    <listAttribute key="org.eclipse.debug.core.MAPPED_RESOURCE_TYPES">
        <listEntry value="1"/>
    </listAttribute>
    <mapAttribute key="org.eclipse.debug.core.environmentVariables">
        <mapEntry key="MY_OPENAI_API_KEY" value="${env_var:sOPENAIZZZ}"/>
        <mapEntry key="OPENAI_API_KEY" value="${env_var:OPENAI_API_KEY}"/>
    </mapAttribute>
    <booleanAttribute key="org.eclipse.jdt.launching.ATTR_ATTR_USE_ARGFILE" value="false"/>
    <booleanAttribute key="org.eclipse.jdt.launching.ATTR_SHOW_CODEDETAILS_IN_EXCEPTION_MESSAGES" value="true"/>
    <booleanAttribute key="org.eclipse.jdt.launching.ATTR_USE_CLASSPATH_ONLY_JAR" value="false"/>
    <stringAttribute key="org.eclipse.jdt.launching.MAIN_TYPE" value="use.tool.eclipse.starter.DevEclipseStarterMain"/>
    <stringAttribute key="org.eclipse.jdt.launching.MODULE_NAME" value="Tool_DevEclipseStarter"/>
    <stringAttribute key="org.eclipse.jdt.launching.PROJECT_ATTR" value="Tool_DevEclipseStarter"/>
</launchConfiguration>
