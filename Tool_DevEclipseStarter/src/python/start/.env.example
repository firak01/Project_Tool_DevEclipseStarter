# Beispieldatei wie die verborgene Datei auszusehen hat

'''
Merke: Dies ist eine Alternative zum Schreiben der Umgebungsvariablen direkt in die Windows Umgebung
       oder auch zu meiner BATCH-DATEI Lösung.
       
Damit die Umgebungsvariablen von Python eingelesen werden können, muss man:
1. Das Paket python-dotenv installieren, mit z.B.:
   C:\python\3.13.17\python.exe -m pip install python-dotenv
   
2. Die Datei einlesen. Wenn die .env Datei nicht im Projektverzeichnis liegt, kann man eine absolute Pfadangabe verwenden.
   Das passiert mit folgendem Python Code:
   

# Damit load_dotenv zur Verfügung steht, muss man es installieren. Hiermit, z.B.:
# C:\python\3.13.17\python.exe -m pip install python-dotenv
import os
from dotenv import load_dotenv

# Direkt in Windows als Benutzer Umgebungsvariable gesetzt. Dabei die Konvention des Names verwendet.
# api_key = os.environ.get("OPENAI_API_KEY")

pathToEnv=os.environ.get("sPLENVZZZ")+"\.env"

#load_dotenv(
#    dotenv_path=r"C:\OpenAI\Config\.env"
#)
load_dotenv(
     dotenv_path=pathToEnv
    )

myTest = os.getenv("MY_TEST")
if not myTest:
    raise RuntimeError("MY_TEST wurde nicht gefunden.")


api_key = os.getenv("OPENAI_API_KEY")
if not api_key:
    raise RuntimeError("OPENAI_API_KEY wurde nicht gefunden.")

print("API-Key erfolgreich geladen.")
    
'''



# Verwendet wird hier: 
OPENAI_API_KEY=<geheimer OPENAI_API_KEY - nicht in github einchecken>


